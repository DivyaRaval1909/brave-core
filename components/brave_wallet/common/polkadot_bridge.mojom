module brave_wallet.mojom;

import "brave/components/brave_wallet/common/brave_wallet.mojom";

// What the bridge frame derives from one signer payload. Both halves come out
// of the same polkadot-js type registry, so they are produced together: a
// description the browser cannot price is only half an answer, and a price for
// something the user was never shown is worse.
struct PolkadotDecodedPayload {
  // The payload's call data as `Call.toHuman()`, JSON-serialized. Display only:
  // it is untrusted input once it reaches the browser.
  string? as_human;

  // The payload re-encoded as an extrinsic bearing a dummy signature, for
  // TransactionPaymentApi_query_info. Never submitted to a chain. polkadot-js
  // assembles this from the same metadata, which is what keeps the signed
  // extensions in the order the runtime declares them.
  array<uint8>? mock_signed_extrinsic;

  string? error;
};

interface PolkadotBridge {
  // Decodes `raw_payload_json` against `metadata_bytes`. The frame does no
  // networking of its own: everything it needs arrives on this call. Null when
  // the payload cannot be decoded, which must fail the signing flow closed.
  Decode(array<uint8> metadata_bytes, string raw_payload_json)
      => (PolkadotDecodedPayload? decoded);
};

interface PolkadotBridgeUIHandler {
  BindPolkadotBridge(pending_remote<PolkadotBridge> bridge);
};
